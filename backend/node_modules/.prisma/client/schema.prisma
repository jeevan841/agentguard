// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users (platform admins / operators) ──────────────────────────────────────
model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  password             String
  name                 String    @default("Admin")
  role                 String    @default("admin") // admin | operator | viewer
  email_verified       Boolean   @default(false)
  email_verify_token   String?   @unique
  email_verify_expires DateTime?
  mfa_level            Int       @default(1) // 1=password only | 2=+email OTP | 3=+TOTP
  totp_secret          String? // encrypted TOTP secret
  totp_enabled         Boolean   @default(false)
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  audit_logs AuditLog[]

  @@map("users")
}

// ─── AI Agents ────────────────────────────────────────────────────────────────
model Agent {
  id                  String   @id @default(uuid())
  name                String
  description         String?
  allowed_tools       String[]
  max_token_budget    Int      @default(4096)
  allowed_data_scopes String[]
  policy_id           String?
  policy              Policy?  @relation(fields: [policy_id], references: [id])
  is_active           Boolean  @default(true)
  metadata            Json?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  audit_logs    AuditLog[]
  red_team_runs RedTeamRun[]

  @@map("agents")
}

// ─── Guardrail Policies ───────────────────────────────────────────────────────
model Policy {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  rules       Json // { pii: bool, injection: bool, blocklist: [], schema: {}, topics: [] }
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  agents Agent[]

  @@map("policies")
}

// ─── Audit Logs (append-only) ─────────────────────────────────────────────────
model AuditLog {
  id                  String   @id @default(uuid())
  timestamp           DateTime @default(now())
  agent_id            String?
  agent               Agent?   @relation(fields: [agent_id], references: [id])
  user_id             String?
  user                User?    @relation(fields: [user_id], references: [id])
  input_hash          String
  output_hash         String?
  tools_called        Json     @default("[]")
  policy_decisions    Json     @default("[]") // [{ check, passed, reason, confidence }]
  latency_ms          Int      @default(0)
  chain_of_thought    String?
  violation_type      String? // pii | injection | output | none
  severity            String? // low | medium | high | critical
  hallucination_score Float?
  metadata            Json?
  created_at          DateTime @default(now())

  @@index([agent_id])
  @@index([timestamp], map: "audit_logs_timestamp_asc_idx")
  @@index([violation_type])
  @@index([user_id])
  @@index([agent_id, timestamp], map: "audit_logs_timestamp_desc_idx")
  @@index([violation_type, severity, timestamp])
  @@index([user_id, timestamp])
  @@index([timestamp(sort: Desc)])
  @@map("audit_logs")
}

// ─── Red-Team Runs ────────────────────────────────────────────────────────────
model RedTeamRun {
  id              String    @id @default(uuid())
  agent_id        String?
  agent           Agent?    @relation(fields: [agent_id], references: [id])
  status          String    @default("pending") // pending | running | completed | failed
  attack_types    String[]
  results         Json      @default("[]") // [{ attack_type, payload, response, was_fooled, severity, score }]
  summary         String?
  pass_rate       Float?
  total_tests     Int       @default(0)
  passed_tests    Int       @default(0)
  failed_tests    Int       @default(0)
  recommendations Json?
  created_at      DateTime  @default(now())
  completed_at    DateTime?

  @@index([agent_id])
  @@map("red_team_runs")
}

// ─── Alert Configurations ─────────────────────────────────────────────────────
model AlertConfig {
  id          String   @id @default(uuid())
  name        String
  metric      String // requests_per_min | guardrail_hit_rate | latency_ms | refusal_rate
  threshold   Float
  operator    String   @default("gt") // gt | lt | eq
  webhook_url String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("alert_configs")
}

// ─── Webhook Configs ──────────────────────────────────────────────────────────
model WebhookConfig {
  id         String   @id @default(uuid())
  name       String
  url        String
  events     String[] // guardrail_violation | redteam_complete | anomaly_detected
  secret     String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  @@map("webhook_configs")
}

// ─── Notifications ────────────────────────────────────────────────────────────
model Notification {
  id         String   @id @default(uuid())
  user_id    String? // null = global notification
  type       String // guardrail_violation | agent_health | redteam_complete | system_alert
  title      String
  message    String
  priority   String   @default("medium") // low | medium | high | critical
  read       Boolean  @default(false)
  action_url String? // Optional link to related resource
  metadata   Json? // Additional context
  created_at DateTime @default(now())
  expires_at DateTime // Auto-delete after 7 days

  @@index([user_id, read])
  @@index([created_at(sort: Desc)])
  @@index([expires_at])
  @@map("notifications")
}

// ─── Revoked Tokens (Blacklist) ───────────────────────────────────────────────
model RevokedToken {
  id         String   @id @default(uuid())
  token_jti  String   @unique // JWT ID (jti claim)
  user_id    String?
  agent_id   String?
  reason     String? // manual_revoke | security_breach | user_logout
  revoked_at DateTime @default(now())
  expires_at DateTime // Original token expiry (for cleanup)

  @@index([token_jti])
  @@index([expires_at])
  @@map("revoked_tokens")
}
