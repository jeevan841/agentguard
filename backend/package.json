{
  "name": "agentguard-backend",
  "version": "1.0.0",
  "description": "AgentGuard AI Governance & Security Platform — Backend",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "seed": "node seed.js",
    "test": "jest --testPathPatterns=test/unit --forceExit",
    "test:coverage": "jest --testPathPatterns=test/unit --coverage --forceExit",
    "benchmark": "node benchmark/run.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^10.69.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.0.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.1",
    "fast-csv": "^5.0.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.15.1",
    "piscina": "^5.3.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^6.0.0",
    "sanitize-html": "^2.11.0",
    "speakeasy": "^2.0.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.1",
    "winston": "^3.11.0",
    "ws": "^8.18.2",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.9",
    "prism": "^1.0.0",
    "prisma": "^5.22.0"
  },
  "nodemonConfig": {
    "ignore": [
      "prisma/*"
    ],
    "ext": "js,json"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 15000,
    "collectCoverageFrom": [
      "src/services/guardrail/**/*.js",
      "src/utils/safeRegex.js",
      "src/services/RedTeamService.js"
    ]
  }
}
