# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://agentguard:agentguard_secret@localhost:5432/agentguard

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# REQUIRED in production - Generate with: openssl rand -base64 24
REDIS_PASSWORD=
# Enable TLS for Redis in production
REDIS_TLS=false

# ─── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED - Must be at least 32 characters
# Generate with: openssl rand -base64 32
# Or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_32_CHAR_MINIMUM_SECRET
JWT_EXPIRES_IN=7d
CAPABILITY_TOKEN_EXPIRES_IN=1h

# ─── Anthropic Claude ─────────────────────────────────────────────────────────
# Optional - Falls back to rule-based detection if not provided
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-20250514

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info  # debug | info | warn | error
FRONTEND_URL=http://localhost:3000

# ─── Email (Mailpit for development) ──────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=AgentGuard <noreply@agentguard.io>

# ─── Alerts / Webhooks ────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
ALERT_EMAIL=
